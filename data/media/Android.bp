package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

android_library {
    name: "jetpack-camera-app_data_media",
    srcs: [
        "src/main/**/*.kt",
    ],
    static_libs: [
        "hilt_android",
        "kotlinx-coroutines-core",
        "jetpack-camera-app_core_common",
    ],
    sdk_version: "34",
    min_sdk_version: "21",
    manifest: "src/main/AndroidManifest.xml",
    apex_available: [
        "com.android.mediaprovider",
    ],
}
