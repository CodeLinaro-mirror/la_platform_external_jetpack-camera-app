package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

android_library {
    name: "jetpack-camera-app_feature_preview",
    srcs: ["src/main/**/*.kt"],
    static_libs: [
        "androidx.compose.runtime_runtime",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.tracing_tracing-ktx",
        "hilt_android",
        "androidx.navigation_navigation-compose",
        "androidx.hilt_hilt-navigation-compose",
        "androidx.compose.ui_ui-tooling",
        "kotlinx_coroutines_guava",
        "androidx.datastore_datastore",
        "libprotobuf-java-lite",
        "androidx.camera_camera-compose",
        "androidx.camera_camera-core",
        "androidx.camera_camera-viewfinder",
        "jetpack-camera-app_data_settings",
        "jetpack-camera-app_core_camera",
        "jetpack-camera-app_core_model",
        "jetpack-camera-app_core_common",
        "jetpack-camera-app_data_media",
        "androidx.compose.ui_ui-tooling",
        "accompanist-permissions",
        "jetpack-camera-app_ui_uistate",
        "jetpack-camera-app_ui_uistateadapter_capture",
        "jetpack-camera-app_ui_uistate_capture",
        "jetpack-camera-app_ui_components_capture",
    ],
    sdk_version: "34",
    min_sdk_version: "23",
    manifest: "src/main/AndroidManifest.xml",
    apex_available: [
        "com.android.mediaprovider",
    ],
}
